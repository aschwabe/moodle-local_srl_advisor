{{!
    @template local_srl_advisor/check_in_panel

    Inline unit check-in panel (DEC-031 v1.1 + DEC-048 v1.1.1 UX patch).

    Mustache auto-escapes by default - closes the XSS surface that an
    innerHTML approach would have left open on label and name/description.
    AMD module renders this server-side template via core/templates.

    DEC-048 changes:
      - Strategy options render as <select> dropdown (was: radio fieldset)
        so panel footprint is tight on long Moodle pages.
      - Default option = "Pick one…" placeholder; submit blocked until a
        real option is selected.
      - Description for the currently-selected option renders in a
        live-updating block below the select; AMD wires the change handler.

    Context vars:
        task_id                int
        is_pre                 bool
        heading                string (already localised via core/str)
        submit_label           string
        dismiss_label          string
        portal_fallback_label  string
        portal_url             string  (launch-page URL for the legacy portal flow)
        aria_label             string
        idempotency_key        string  (UUID v4 generated client-side)
        placeholder_label      string  ("Pick one…" — localised)
        other_label            string  (label for the free-text "Other" input)
        other_placeholder      string  (placeholder for the free-text input)
        options                array of {kind, strategy_id, name, description, label}

    Example context (json):
    {
        "task_id": 12,
        "is_pre": true,
        "heading": "Before you start this section, what strategy will you use?",
        "submit_label": "Save",
        "dismiss_label": "Not now",
        "portal_fallback_label": "Read more about learning strategies on SRL Advisor",
        "portal_url": "https://srladvisor.example.com/launch",
        "aria_label": "SRL Advisor check-in",
        "idempotency_key": "3f2504e0-4f89-41d3-9a0c-0305e82c3301",
        "placeholder_label": "Pick one…",
        "other_label": "Tell us briefly which strategy you have in mind",
        "other_placeholder": "In your own words (max 200 chars)…",
        "options": [
            {"kind": "strategy", "strategy_id": 3, "name": "Retrieval practice", "description": "Test yourself without notes", "label": "Retrieval practice"}
        ]
    }
}}
<aside class="srladvisor-check-in"
       role="region"
       aria-label="{{aria_label}}"
       data-task-id="{{task_id}}"
       data-is-pre="{{#is_pre}}1{{/is_pre}}{{^is_pre}}0{{/is_pre}}"
       data-idempotency-key="{{idempotency_key}}">
    <div class="srladvisor-check-in__brand" aria-hidden="true">
        <span class="srladvisor-check-in__brand-dot"></span>SRL Advisor
    </div>
    <h3 class="srladvisor-check-in__heading">{{heading}}</h3>
    <form class="srladvisor-check-in__form" data-srladvisor-form>
        <label class="srladvisor-check-in__select-label" for="srladvisor-choice-{{task_id}}">
            <span class="sr-only">{{aria_label}}</span>
            <select class="form-control srladvisor-check-in__select"
                    id="srladvisor-choice-{{task_id}}"
                    name="srladvisor_choice"
                    data-srladvisor-select
                    required>
                <option value="" data-strategy-id="0" data-no-strategy="0" data-description="" label="{{placeholder_label}}" selected>{{placeholder_label}}</option>
                {{#options}}
                    {{#strategy_id}}
                        <option value="strategy:{{strategy_id}}"
                                data-strategy-id="{{strategy_id}}"
                                data-kind="strategy"
                                data-no-strategy="0"
                                data-other="0"
                                data-description="{{description}}">{{name}}</option>
                    {{/strategy_id}}
                    {{^strategy_id}}
                        <option value="{{kind}}"
                                data-strategy-id="0"
                                data-kind="{{kind}}"
                                data-no-strategy="{{#is_no_strategy}}1{{/is_no_strategy}}{{^is_no_strategy}}0{{/is_no_strategy}}"
                                data-other="{{#is_other}}1{{/is_other}}{{^is_other}}0{{/is_other}}"
                                data-description="">{{label}}</option>
                    {{/strategy_id}}
                {{/options}}
            </select>
        </label>
        <p class="srladvisor-check-in__description" data-srladvisor-description aria-live="polite"></p>
        <label class="srladvisor-check-in__other-label" data-srladvisor-other-wrap hidden>
            <span class="srladvisor-check-in__other-label-text">{{other_label}}</span>
            <input type="text"
                   class="form-control srladvisor-check-in__other-input"
                   data-srladvisor-other-input
                   maxlength="200"
                   placeholder="{{other_placeholder}}"
                   autocomplete="off">
        </label>
        <div class="srladvisor-check-in__actions">
            <button type="submit" class="btn btn-primary" data-srladvisor-submit disabled>{{submit_label}}</button>
            <button type="button" class="btn btn-secondary" data-srladvisor-dismiss>{{dismiss_label}}</button>
            <a class="srladvisor-check-in__portal-link" href="{{portal_url}}" target="_blank" rel="noopener">{{portal_fallback_label}}</a>
        </div>
        <p class="srladvisor-check-in__status" data-srladvisor-status aria-live="polite"></p>
    </form>
</aside>
